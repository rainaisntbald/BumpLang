class Duration implements Comparable {
    public Integer seconds;

    public fun void init(Integer seconds) {
        this.seconds = seconds;
    }

    public fun Duration plus(Duration other) {
        return Duration(this.seconds + other.seconds);
    }

    public fun Duration minus(Duration other) {
        return Duration(this.seconds - other.seconds);
    }

    public fun Integer in_minutes() {
        return this.seconds / 60;
    }

    public fun Integer in_hours() {
        return this.seconds / 3600;
    }

    public fun Integer in_days() {
        return this.seconds / 86400;
    }

    public fun Bool _eq(Duration other) {
        return this.seconds == other.seconds;
    }

    public fun Bool _gt(Duration other) {
        return this.seconds > other.seconds;
    }

    public fun Bool _gte(Duration other) {
        return this.seconds >= other.seconds;
    }

    public fun Bool _lt(Duration other) {
        return this.seconds < other.seconds;
    }

    public fun Bool _lte(Duration other) {
        return this.seconds <= other.seconds;
    }

    public fun String to_string() {
        return str(this.seconds) + "s";
    }
}

class DateTime implements Comparable {
    private Integer _epoch_seconds = 0;

    public fun void init() {
        Integer epoch = 0;
        unsafe_java {
            long now = java.time.Instant.now().getEpochSecond();
            if (now < Integer.MIN_VALUE || now > Integer.MAX_VALUE) {
                throw new IllegalArgumentException("Current epoch second is out of Integer range.");
            }
            set("epoch", (int) now, interpreter, environment);
        }
        this._epoch_seconds = epoch;
    }

    public fun void init(Integer epoch_seconds) {
        this._epoch_seconds = epoch_seconds;
    }

    public fun void init(Integer year, Integer month, Integer day) {
        this._epoch_seconds = this._epoch_from_parts(year, month, day, 0, 0, 0);
    }

    public fun void init(Integer year, Integer month, Integer day, Integer hour, Integer minute, Integer second) {
        this._epoch_seconds = this._epoch_from_parts(year, month, day, hour, minute, second);
    }

    public fun void init(String date_str) {
        if (date_str.length() != 19) {
            this._throw_invalid_iso(date_str);
        }
        if (date_str.substring(4, 5) != "-" || date_str.substring(7, 8) != "-"
                || date_str.substring(10, 11) != "T" || date_str.substring(13, 14) != ":"
                || date_str.substring(16, 17) != ":") {
            this._throw_invalid_iso(date_str);
        }

        Integer year = this._parse_two_or_more_digits(date_str.substring(0, 4), 4);
        Integer month = this._parse_two_or_more_digits(date_str.substring(5, 7), 2);
        Integer day = this._parse_two_or_more_digits(date_str.substring(8, 10), 2);
        Integer hour = this._parse_two_or_more_digits(date_str.substring(11, 13), 2);
        Integer minute = this._parse_two_or_more_digits(date_str.substring(14, 16), 2);
        Integer second = this._parse_two_or_more_digits(date_str.substring(17, 19), 2);

        this._epoch_seconds = this._epoch_from_parts(year, month, day, hour, minute, second);
    }

    public fun void init(DateTime other) {
        this._epoch_seconds = other._epoch_seconds;
    }

    private fun void _throw_invalid_iso(String input) {
        ValueError err = ValueError();
        err.message = "Invalid DateTime string '" + input + "'. Expected format YYYY-MM-DDTHH:MM:SS.";
        throw(err);
    }

    private fun Integer _digit(String ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        ValueError err = ValueError();
        err.message = "Invalid digit '" + ch + "' in DateTime.";
        throw(err);
        return 0;
    }

    private fun Integer _parse_two_or_more_digits(String s, Integer expected_len) {
        if (s.length() != expected_len) {
            ValueError err = ValueError();
            err.message = "Invalid numeric DateTime segment '" + s + "'.";
            throw(err);
        }
        Integer value = 0;
        for (Integer i = 0; i < s.length(); i++) {
            value = value * 10 + this._digit(s.substring(i, i + 1));
        }
        return value;
    }

    private fun void _require_range(Integer value, Integer lower, Integer upper, String label) {
        if (value < lower || value > upper) {
            ValueError err = ValueError();
            err.message = label + " out of range: " + str(value) + " (expected " + str(lower) + ".." + str(upper) + ").";
            throw(err);
        }
    }

    private fun Integer _epoch_from_parts(Integer year, Integer month, Integer day, Integer hour, Integer minute, Integer second) {
        this._require_range(year, 1, 9999, "Year");
        this._require_range(month, 1, 12, "Month");
        this._require_range(hour, 0, 23, "Hour");
        this._require_range(minute, 0, 59, "Minute");
        this._require_range(second, 0, 59, "Second");

        Integer epoch = 0;
        try {
            unsafe_java {
                Integer year = (Integer) get("year", environment);
                Integer month = (Integer) get("month", environment);
                Integer day = (Integer) get("day", environment);
                Integer hour = (Integer) get("hour", environment);
                Integer minute = (Integer) get("minute", environment);
                Integer second = (Integer) get("second", environment);

                java.time.LocalDateTime dateTime = java.time.LocalDateTime.of(year, month, day, hour, minute, second);
                long epochSecond = dateTime.toEpochSecond(java.time.ZoneOffset.UTC);
                if (epochSecond < Integer.MIN_VALUE || epochSecond > Integer.MAX_VALUE) {
                    throw new IllegalArgumentException("DateTime is out of Integer epoch range.");
                }
                set("epoch", (int) epochSecond, interpreter, environment);
            }
        } catch (Exception ignored) {
            ValueError err = ValueError();
            err.message = "Invalid date/time: "
                    + this._pad(year, 4) + "-"
                    + this._pad(month, 2) + "-"
                    + this._pad(day, 2) + "T"
                    + this._pad(hour, 2) + ":"
                    + this._pad(minute, 2) + ":"
                    + this._pad(second, 2);
            throw(err);
        }
        return epoch;
    }

    private fun Integer _utc_part(String part) {
        Integer epoch = this._epoch_seconds;
        String key = part;
        Integer out = 0;
        unsafe_java {
            Integer epoch = (Integer) get("epoch", environment);
            String key = (String) get("key", environment);
            java.time.LocalDateTime dt = java.time.LocalDateTime.ofEpochSecond(epoch.longValue(), 0, java.time.ZoneOffset.UTC);
            int value = switch (key) {
                case "year" -> dt.getYear();
                case "month" -> dt.getMonthValue();
                case "day" -> dt.getDayOfMonth();
                case "hour" -> dt.getHour();
                case "minute" -> dt.getMinute();
                case "second" -> dt.getSecond();
                default -> throw new IllegalArgumentException("Unknown DateTime part: " + key);
            };
            set("out", value, interpreter, environment);
        }
        return out;
    }

    public fun Integer year() {
        return this._utc_part("year");
    }

    public fun Integer month() {
        return this._utc_part("month");
    }

    public fun Integer day() {
        return this._utc_part("day");
    }

    public fun Integer hour() {
        return this._utc_part("hour");
    }

    public fun Integer minute() {
        return this._utc_part("minute");
    }

    public fun Integer second() {
        return this._utc_part("second");
    }

    private fun String _pad(Integer value, Integer width) {
        String s = str(value);
        while (s.length() < width) {
            s = "0" + s;
        }
        return s;
    }

    public fun String to_string() {
        return this._pad(this.year(), 4)
                + "-" + this._pad(this.month(), 2)
                + "-" + this._pad(this.day(), 2)
                + "T" + this._pad(this.hour(), 2)
                + ":" + this._pad(this.minute(), 2)
                + ":" + this._pad(this.second(), 2);
    }

    public fun Bool _eq(DateTime other) {
        return this._epoch_seconds == other._epoch_seconds;
    }

    public fun Bool _gt(DateTime other) {
        return this._epoch_seconds > other._epoch_seconds;
    }

    public fun Bool _gte(DateTime other) {
        return this._epoch_seconds >= other._epoch_seconds;
    }

    public fun Bool _lt(DateTime other) {
        return this._epoch_seconds < other._epoch_seconds;
    }

    public fun Bool _lte(DateTime other) {
        return this._epoch_seconds <= other._epoch_seconds;
    }

    public fun Integer epoch_seconds() {
        return this._epoch_seconds;
    }

    public fun DateTime add_seconds(Integer seconds) {
        return DateTime(this._epoch_seconds + seconds);
    }

    public fun DateTime minus_seconds(Integer seconds) {
        return this.add_seconds(0 - seconds);
    }

    public fun DateTime add_minutes(Integer minutes) {
        return this.add_seconds(minutes * 60);
    }

    public fun DateTime add_hours(Integer hours) {
        return this.add_seconds(hours * 3600);
    }

    public fun DateTime add_days(Integer days) {
        return this.add_seconds(days * 86400);
    }

    public fun DateTime with_time(Integer hour, Integer minute, Integer second) {
        return DateTime(this.year(), this.month(), this.day(), hour, minute, second);
    }

    public fun DateTime start_of_day() {
        return this.with_time(0, 0, 0);
    }

    public fun Duration since(DateTime other) {
        return Duration(this._epoch_seconds - other._epoch_seconds);
    }
}

fun DateTime now() {
    return DateTime();
}

fun Duration seconds(Integer value) {
    return Duration(value);
}

fun Duration minutes(Integer value) {
    return Duration(value * 60);
}

fun Duration hours(Integer value) {
    return Duration(value * 3600);
}

fun Duration days(Integer value) {
    return Duration(value * 86400);
}
