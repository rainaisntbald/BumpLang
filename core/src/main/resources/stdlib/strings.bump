import "stdlib.arrayList";

class StringBuilder {
    private ArrayList<String> _parts = ArrayList<String>();

    public fun void init() {
        this._parts = ArrayList<String>();
    }

    public fun StringBuilder append(String part) {
        this._parts.add(part);
        return this;
    }

    public fun StringBuilder append_line(String part) {
        this._parts.add(part + "\n");
        return this;
    }

    public fun Integer parts_count() {
        return this._parts.size();
    }

    public fun void clear() {
        this._parts.clear();
    }

    public fun String build() {
        return this._parts.join("");
    }
}

extend String {
    fun Bool is_blank() { return this.trim() == ""; }

    fun Array lines() { return this.split("\n"); }

    fun Array words() {
        Array out = [];
        Integer length = this.length();
        Integer i = 0;

        while (i < length) {
            while (i < length) {
                String ch = this.substring(i, i + 1);
                if (ch != " " && ch != "\n" && ch != "\t" && ch != "\r") {
                    break;
                }
                i += 1;
            }
            if (i >= length) {
                break;
            }

            Integer start = i;
            while (i < length) {
                String ch = this.substring(i, i + 1);
                if (ch == " " || ch == "\n" || ch == "\t" || ch == "\r") {
                    break;
                }
                i += 1;
            }
            out.push(this.substring(start, i));
        }

        return out;
    }

    fun String repeat_join(Integer times, String separator) {
        if (times <= 0) {
            return "";
        }
        String out = "";
        for (Integer i = 0; i < times; i++) {
            if (i > 0) {
                out += separator;
            }
            out += this;
        }
        return out;
    }

    fun String repeat_with(Integer times, String separator) {
        return this.repeat_join(times, separator);
    }
}

fun String join(Array values, String separator) {
    return values.join(separator);
}
